<snippet>
	<content><![CDATA[use Workerman\Worker;
use Workerman\Protocols\Http\Session;

\$worker = new Worker('${1:http://0.0.0.0:8080}');

\$worker->onMessage = function (\$connection, \$data) {
    \$session = Session::get(\$connection->sessionId);
    \$session['${2:user_id}'] = ${3:1};
    \$session->save();
    
    \$connection->send('Session saved');
};

Worker::runAll();]]></content>
	<scope>source.php</scope>
	<tabTrigger>wksession</tabTrigger>
	<description>Workerman Session</description>
</snippet>
