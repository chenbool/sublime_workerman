<snippet>
	<content><![CDATA[use Workerman\Worker;
use Workerman\Lib\Timer;

\$worker = new Worker('${1:text://0.0.0.0:8080}');
\$worker->onMessage = function (\$connection, \$data) {
    Timer::add(1, function () {
        echo "Timer tick\n";
    });
    \$connection->send('ok');
};]]></content>
