	<content><![CDATA[use Workerman\Worker;
use Workerman\Connection\AsyncTcpConnection;

\$worker = new Worker();
\$worker->onMessage = function (\$connection, \$data) {
    \$asyncConnection = new AsyncTcpConnection('${1:tcp://127.0.0.1:8081}');
    \$asyncConnection->onConnect = function (\$conn) use (\$connection, \$data) {
        \$conn->send(\$data);
    };
    \$asyncConnection->onMessage = function (\$conn, \$data) use (\$connection) {
        \$connection->send(\$data);
        \$conn->close();
    };
    \$asyncConnection->connect();
};]]></content>
	<scope>source.php</scope>
	<tabTrigger>wkasync</tabTrigger>
	<description>Workerman 异步TCP连接</description>
</snippet>
