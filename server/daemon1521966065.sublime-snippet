<snippet>
	<content><![CDATA[use Workerman\Worker;

Worker::\$stdoutFile = '/dev/null';
Worker::\$logFile = '/tmp/workerman.log';
Worker::\$pidFile = '/tmp/workerman.pid';

\$worker = new Worker('${1:http://0.0.0.0:8080}');
\$worker->count = 4;

\$worker->onMessage = function (\$connection, \$data) {
    \$connection->send('Hello');
};

Worker::runAll();]]></content>
	<scope>source.php</scope>
	<tabTrigger>wkdaemon</tabTrigger>
	<description>Workerman 守护进程配置</description>
</snippet>
