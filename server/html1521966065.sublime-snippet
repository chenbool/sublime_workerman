<snippet>
	<content><![CDATA[<?php

require_once __DIR__ . '/vendor/autoload.php';

use Workerman\Worker;

\$worker = new Worker('${1:http://0.0.0.0:8080}');

\$worker->onMessage = function (\$connection, \$data) {
    \$connection->send(<<<HTML
<!DOCTYPE html>
<html>
<head><title>Workerman</title></head>
<body>
    <h1>Hello Workerman</h1>
</body>
</html>
HTML
    );
};

Worker::runAll();]]></content>
